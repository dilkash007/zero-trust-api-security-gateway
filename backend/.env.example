# ============================================================
# Zero-Trust API Security Engine — Production .env Template
# Copy this to .env and fill in ALL values before deploying.
# NEVER commit .env to version control.
# ============================================================

APP_NAME="Zero-Trust API Security Engine"
APP_VERSION="1.0.0"
DEBUG=false

# ---- Database -------------------------------------------------
# PostgreSQL production connection string
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://zt_user:CHANGE_ME@db:5432/zero_trust_db

# ---- Redis ----------------------------------------------------
# Used for production rate limiting & session caching.
# Omit or leave blank to fall back to in-memory (dev only).
REDIS_URL=redis://redis:6379/0

# ---- CORS -----------------------------------------------------
# Comma-separated list or JSON array of allowed frontend origins
CORS_ORIGINS=["https://yourdomain.com"]

# ---- JWT ------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Rate Limiting --------------------------------------------
# Global per-IP sliding window (100 req / 60 s recommended)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Per-user window for authenticated traffic
RATE_LIMIT_USER_REQUESTS=200
RATE_LIMIT_USER_WINDOW_SECONDS=60

# Burst protection window (20 req / 5 s)
RATE_LIMIT_BURST_REQUESTS=20
RATE_LIMIT_BURST_WINDOW_SECONDS=5

# IP auto-block duration after repeated limit breaches (seconds)
RATE_LIMIT_BLOCK_DURATION_SECONDS=3600

# ---- Policy Enforcement ---------------------------------------
# true  = actively BLOCK CRITICAL-risk requests (production)
# false = record but do not block (shadow mode)
POLICY_ENFORCEMENT_ACTIVE=true

# ---- Upstream Forwarding (reverse-proxy mode) -----------------
# Set to your upstream service base URL to enable forwarding
# UPSTREAM_BASE_URL=http://upstream-service:8080
